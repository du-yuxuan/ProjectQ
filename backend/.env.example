# Q v17 后端环境配置

# 服务端口
PORT=3001

# 讯飞实时语音转写（RTASR 大模型版）
IFLYTEK_APPID=
IFLYTEK_API_KEY=
IFLYTEK_API_SECRET=
IFLYTEK_WS_URL=wss://office-api-ast-dx.iflyaisol.com
IFLYTEK_ROLE_TYPE=2
IFLYTEK_MAX_SPEAKERS=4

# 阶跃星辰 LLM（直接调用，无 Dify 中间层）
STEPAUDIO_API_KEY=
STEPAUDIO_LLM_URL=https://api.stepfun.com/v1/chat/completions
STEPAUDIO_LLM_MODEL=step-3.7-flash
STEPAUDIO_LOGIC_INTERVAL_S=5

# 数据库
DATABASE_URL=file:./dev.db

# Injective 链上凭证
INJECTIVE_RPC=https://testnet-rpc.injective.dev
INJECTIVE_REST=https://testnet-lcd.injective.dev
INJECTIVE_MNEMONIC=
INJECTIVE_CHAIN_ID=injective-888
INJECTIVE_CONTRACT_ADDRESS=

# WalletConnect Bridge
WALLETCONNECT_BRIDGE=https://bridge.walletconnect.org

# 心率手动输入面板阈值
HR_CALM_BASELINE=70
HR_TENSION_THRESHOLD=120
HR_PANIC_THRESHOLD=160

# PICO 空间渲染
SPECIES_MAPPING=true
AUDIENCE_FEEDBACK=true
